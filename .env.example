# === Bảo mật admin (BẮT BUỘC cấu hình trên production) ===
# Mật khẩu quản trị (sha256:<hex>). Tạo bằng: node -e "console.log('sha256:'+require('crypto').createHash('sha256').update('MAT_KHAU_CUA_BAN').digest('hex'))"
ADMIN_PASSWORD_HASH=

# Khóa ký session cookie (chuỗi ngẫu nhiên dài, bảo mật). Bắt buộc để đăng nhập hoạt động.
# Tạo bằng: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# API key Gemini cho chatbot AI (server-only, KHÔNG lưu trong content/ai_config.json)
GEMINI_API_KEY=
